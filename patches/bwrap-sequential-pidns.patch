--- vanilla/bubblewrap.c
+++ bubblewrap-0.11.2/bubblewrap.c
@@ -3145,6 +3145,22 @@
       create_pid_socketpair (intermediate_pids_sockets);
     }
 
+  /* Vendor-kernel workaround (Android 4.x perf kernels):
+   *  1) Creating the USER and PID namespaces atomically in one clone() makes
+   *     every later fresh procfs mount fail with EBUSY.
+   *  2) unshare(CLONE_NEWNET) fails with ENOMEM on these kernels, so we
+   *     cannot create the namespaces in sequential unshare() calls either.
+   * Therefore keep the combined clone() but WITHOUT CLONE_NEWPID; the child
+   * enters a fresh PID namespace afterwards via unshare()+fork(), and the
+   * intermediate process forwards the sandbox process's exit status. */
+  bool split_pid_entry = false;
+  if ((clone_flags & (CLONE_NEWUSER | CLONE_NEWPID)) ==
+      (CLONE_NEWUSER | CLONE_NEWPID))
+    {
+      clone_flags &= ~(unsigned long) CLONE_NEWPID;
+      split_pid_entry = true;
+    }
+
   pid = raw_clone (clone_flags, NULL);
   if (pid == -1)
     {
@@ -3315,6 +3331,27 @@
       write_uid_gid_map (ns_uid, real_uid,
                          ns_gid, real_gid,
                          -1, true, false);
+    }
+
+  if (split_pid_entry)
+    {
+      /* Enter the new PID namespace: unshare affects future children only */
+      if (unshare (CLONE_NEWPID) < 0)
+        die_with_error ("unshare pid ns");
+
+      pid_t gchild = fork ();
+      if (gchild < 0)
+        die_with_error ("Forking into new pid namespace");
+
+      if (gchild != 0)
+        {
+          /* Intermediate process: forward the sandbox init's exit status */
+          int st;
+          if (TEMP_FAILURE_RETRY (waitpid (gchild, &st, 0)) < 0)
+            die_with_error ("waitpid for sandboxed process");
+          return propagate_exit_status (st);
+        }
+      /* We are now the first process of the new PID namespace; continue */
     }
 
   old_umask = umask (0);
